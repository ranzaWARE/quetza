# Copia questo file in .env e compila i valori
# cp .env.example .env

# Porta HTTP interna del container (default 3000)
PORT=3000

# Stringa segreta per le sessioni — CAMBIALA con qualcosa di lungo e casuale.
# Obbligatoria: senza, docker compose si rifiuta di partire e l'app userebbe
# un segreto casuale rigenerato a ogni riavvio (sessioni invalidate).
#   openssl rand -hex 32
SESSION_SECRET=metti_qui_una_stringa_lunga_e_casuale_almeno_32_caratteri

# IP del server, usato nel certificato self-signed generato all'avvio
SERVER_IP=127.0.0.1

# Numero di reverse proxy davanti all'app (0 = nessuno, 1 = un nginx).
# Serve al rate limiter per leggere l'IP reale del client da X-Forwarded-For:
# con il valore sbagliato tutti gli utenti dietro lo stesso proxy condividono
# lo stesso contatore di richieste.
TRUST_PROXY=1

# ── Whisper (trascrizione) ───────────────────────────────
# Modello: tiny | base | small | medium | large-v3
# Più grande = più accurato ma più lento e più RAM.
# Modificabile anche a caldo dal pannello Amministrazione.
WHISPER_MODEL=small

# Token Hugging Face — necessario SOLO per la diarizzazione (chi ha detto cosa).
# Va accettata la licenza di pyannote/speaker-diarization-3.1 sul sito HF.
# Senza token la trascrizione funziona comunque, ma senza distinguere i parlanti.
HF_TOKEN=

# Lingua principale dell'audio
LANGUAGE=it

# ── LDAP / Active Directory ──────────────────────────────
# Nota: anche con LDAP attivo, gli account locali restano utilizzabili come
# fallback (tab "Locale" del login), così un AD irraggiungibile non blocca
# l'accesso amministrativo.
LDAP_ENABLED=false

# IP o hostname del Domain Controller
LDAP_URL=ldap://192.168.1.10:389

# Service account per la ricerca utenti (sola lettura)
LDAP_BIND_DN=CN=svc_quetza,OU=ServiceAccounts,DC=graphimecc,DC=local
LDAP_BIND_PASSWORD=password_del_service_account

# Base di ricerca degli utenti
LDAP_SEARCH_BASE=DC=graphimecc,DC=local

# Filtro: sAMAccountName = username Windows
LDAP_SEARCH_FILTER=(sAMAccountName={{username}})

# false = accetta certificati self-signed (comune in ambienti AD interni)
LDAP_TLS_REJECT_UNAUTHORIZED=false
