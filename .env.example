# Configurazione di Quetza. ./installa.sh crea il file .env da questo modello
# e compila da solo SESSION_SECRET e SERVER_IP. A mano:
#   cp .env.example .env    e compila almeno i due valori obbligatori.
# Dopo ogni modifica: docker compose up -d

# ── Obbligatori ───────────────────────────────────────────────────────────
# Segreto delle sessioni, lungo e casuale:  openssl rand -hex 32
# Cambiarlo disconnette tutti gli utenti.
SESSION_SECRET=

# IP del server nella LAN: finisce nel certificato self-signed.
SERVER_IP=

# Nome dell'organizzazione, mostrato nella pagina di accesso. Il logo
# aziendale va nella cartella ./logo (logo.svg, .png, .webp o .jpg).
ORG_NAME=

# ── Indirizzo e porte ─────────────────────────────────────────────────────
# Nome DNS del server (es. quetza.azienda.local), se ne ha uno: entra nel
# certificato self-signed insieme all'IP.
SERVER_NAME=

# Porte sul server. La HTTP fa solo il redirect verso la HTTPS.
QUETZA_HTTPS_PORT=8443
QUETZA_HTTP_PORT=8080

# Indirizzo completo con cui gli utenti aprono Quetza. Vuoto = https://<host>:<QUETZA_HTTPS_PORT>
PUBLIC_URL=

# true = la porta HTTP serve tutta l'app invece del solo redirect.
# Sconsigliato: password e note viaggiano in chiaro, e il browser non
# permette di registrare audio fuori da HTTPS.
ALLOW_HTTP=false

# Reverse proxy davanti a Quetza: 0 = nessuno, 1 = nginx (profilo "nginx").
TRUST_PROXY=0

# DNS da usare nei container (es. il domain controller) se LDAP o il provider
# SSO si raggiungono per nome e Docker non li risolve. Vuoto = DNS dell'host.
DNS_SERVER=

# ── Backup ────────────────────────────────────────────────────────────────
# Cartella sul server dove finiscono i backup notturni del DB.
BACKUP_PATH=./backups
# Orario (formato cron) e numero di copie da tenere.
BACKUP_CRON=0 2 * * *
BACKUP_KEEP=30

# Dimensione massima di un archivio ZIP importato (MB). Serve altrettanta RAM
# libera; l'import da Amministrazione accetta fino a 4 volte questo valore.
IMPORT_MAX_MB=1024

# ── Trascrizione (Whisper) ────────────────────────────────────────────────
# Modello: tiny | base | small | medium | large-v3
# Più grande = più preciso ma più lento e con più RAM. Si cambia anche da
# Amministrazione → Whisper senza riavviare.
WHISPER_MODEL=small
LANGUAGE=it
# RAM massima del container di trascrizione.
WHISPER_MEMORY=6G
# Tempo massimo per una trascrizione (minuti).
WHISPER_TIMEOUT_MIN=60

# Token Hugging Face, solo per riconoscere chi parla (diarizzazione).
# Va accettata la licenza di pyannote/speaker-diarization-3.1 su huggingface.co.
HF_TOKEN=

# ── LDAP / Active Directory (facoltativo) ─────────────────────────────────
# Si può configurare anche da Amministrazione → LDAP, che ha la precedenza.
# Gli account locali restano utilizzabili come fallback (tab "Locale").
LDAP_ENABLED=false
LDAP_URL=ldap://dc.azienda.local:389
# Service account di sola lettura per la ricerca degli utenti
LDAP_BIND_DN=CN=svc_quetza,OU=ServiceAccounts,DC=azienda,DC=local
LDAP_BIND_PASSWORD=
LDAP_SEARCH_BASE=DC=azienda,DC=local
# sAMAccountName = nome utente Windows
LDAP_SEARCH_FILTER=(sAMAccountName={{username}})
# false = accetta certificati non verificabili (sconsigliato: meglio mettere
# la CA aziendale nella cartella ./ca)
LDAP_TLS_REJECT_UNAUTHORIZED=true

# ── SSO / OIDC (facoltativo) ──────────────────────────────────────────────
# Quetza fa solo da client: funziona con qualsiasi provider OIDC esistente
# (Keycloak, Entra ID, Authentik, …) e non ne installa nessuno. Si configura
# da Amministrazione → SSO / OIDC.
# URL dell'issuer raggiungibile dal container, se diverso da quello pubblico.
OIDC_INTERNAL_URL=
# Se il provider ha un certificato interno, metti la CA (*.crt o *.pem) in ./ca/
